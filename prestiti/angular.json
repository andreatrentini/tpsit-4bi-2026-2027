{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "prestiti": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "baseHref": "/@ad-54975361f23b4a5cbaa22a50/TPSIT-4Bi-2026-2027.main/apps/code-server/proxy/8000/",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "options": {
            "host": "0.0.0.0",
            "port": 8000,
            "servePath": "/",
            "prebundle": false,
            "hmr": false,
            "liveReload": false,
            "allowedHosts": ["code.marconirovereto.it"]
          },
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "prestiti:build:production"
            },
            "development": {
              "buildTarget": "prestiti:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "poll": 1000
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}